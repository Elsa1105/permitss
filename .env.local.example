# Supabase --- fill these in once you have your Supabase project keys.
# Get them at: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Do NOT expose to the browser. Used for admin actions
# (CSV upload of qualified personnel, audit-log access, transitions).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: name of the Supabase Storage bucket used for permit photos.
# Default is "permit-photos". Create the bucket in Supabase before use.
SUPABASE_STORAGE_BUCKET=permit-photos
